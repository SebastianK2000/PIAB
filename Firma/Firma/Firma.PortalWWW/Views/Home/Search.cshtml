@model IEnumerable<Firma.Data.Data.Sklep.Product>

@{
    ViewData["Title"] = "Product Search";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/tabs.css" />

<div class="ipad-store-container">
    <h1 class="store-title">Search products</h1>

    <form method="get" asp-action="Search" class="mb-4">
        <div class="d-flex flex-wrap gap-2">
            <input type="text" name="query" placeholder="Search by name..." value="@ViewBag.Query" class="form-control" style="width: 250px;" />
            <select name="kind" class="form-select" style="width: 180px;">
                <option value="">All types</option>
                @foreach (var k in ViewBag.Kinds as List<string>)
                {
                    var selected = k == ViewBag.SelectedKind ? "selected" : "";
                    <option value="@k" >@k</option>
                }
            </select>
            <button type="submit" class="btn">Filter</button>
        </div>
    </form>

    <div class="grid-container">
        @foreach (var item in Model)
        {
            <div class="card">
                <h2 class="top-h2-padding">@item.Name</h2>
                <img src="@item.ImageUrl" alt="@item.Name">
                <div class="p-and-button">
                    <p class="price">$ @item.Price.ToString("F2")</p>
                    <a href="javascript:void(0);" class="btn"
                       onclick="openModal('@item.IdProduct', '@item.Name', '@item.ImageUrl', '@item.Price')">
                        Buy
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal -->
<div id="product-modal" class="modal hidden">
    <div class="modal-content">
        <span class="close" onclick="closeModal()">&times;</span>
        <h2 id="modal-name"></h2>
        <img id="modal-image" src="" alt="" />
        <p id="modal-price"></p>
        <button type="button" class="btn" id="modal-buy-button">Buy</button>
    </div>
</div>
<div id="blur-overlay" class="blur-overlay hidden"></div>

<script>
    function openModal(id, name, imageUrl, price) {
        const modal = document.getElementById('product-modal');
        const overlay = document.getElementById('blur-overlay');

        document.getElementById('modal-name').innerText = name;
        document.getElementById('modal-image').src = imageUrl;
        document.getElementById('modal-image').alt = name;
        document.getElementById('modal-price').innerText = `$ ${parseFloat(price).toFixed(2)}`;

        const buyBtn = document.getElementById('modal-buy-button');
        buyBtn.setAttribute("data-id", id);

        modal.classList.remove('hidden');
        overlay.classList.remove('hidden');

        modal.style.display = 'block';
        overlay.style.display = 'block';
        modal.style.visibility = 'visible';
        modal.style.opacity = '1';
    }

    document.addEventListener("DOMContentLoaded", function () {
        const buyBtn = document.getElementById('modal-buy-button');
        buyBtn.addEventListener('click', function () {
            const productId = this.getAttribute("data-id");
            window.location.href = `/Home/CreateOrders/${productId}`;
        });
    });

    function closeModal() {
        const modal = document.getElementById('product-modal');
        const overlay = document.getElementById('blur-overlay');

        modal.classList.add('hidden');
        overlay.classList.add('hidden');

        modal.style.display = 'none';
        overlay.style.display = 'none';
    }
</script>
