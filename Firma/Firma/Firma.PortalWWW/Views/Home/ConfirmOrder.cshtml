@model Firma.Data.Data.Sklep.Orders

@{
    ViewData["Title"] = "Confirm Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Confirm Your Order</h1>

<div class="card p-4">
    <p><strong>User:</strong> @Model.User</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Address:</strong> @Model.Address</p>
    <p><strong>Payment:</strong> @Model.PaymentMethod</p>
    <p><strong>Delivery:</strong> @Model.DeliveryMethod</p>
    <p><strong>Product:</strong> @Model.Product?.Name</p>
    <p><strong>Price:</strong> $@Model.Product?.Price.ToString("F2")</p>

    <form asp-action="FinalizeOrder" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="User" />
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Address" />
        <input type="hidden" asp-for="PaymentMethod" />
        <input type="hidden" asp-for="DeliveryMethod" />
        <input type="hidden" asp-for="IdProducts" />

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-success">Confirm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
